{
  "name": "@edteam/edcheck",
  "version": "0.1.0",
  "description": "Semantic validation for Zod schemas, powered by TypeSafe Jev. Validate meaning, not just structure.",
  "keywords": [
    "zod",
    "validation",
    "semantic",
    "schema",
    "typesafe",
    "jev",
    "ai"
  ],
  "license": "MIT",
  "author": "EDlabs / EDteam",
  "homepage": "https://github.com/edteamlat/EDcheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edteamlat/EDcheck.git"
  },
  "bugs": {
    "url": "https://github.com/edteamlat/EDcheck/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "prepublishOnly": "yarn verify",
    "eval": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/eval/noul-rules.eval.test.ts test/eval/score-rules.eval.test.ts --fileParallelism=false",
    "spec:validate": "openspec validate --all"
  },
  "peerDependencies": {
    "@ai-sdk/gateway": ">=4.0.85 <5",
    "ai": ">=7.0.105 <8",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/gateway": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ai": "^7.0.105",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
